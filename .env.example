NODE_ENV=production
# Railway assigns PORT and RAILWAY_VOLUME_MOUNT_PATH.
# PORT=3000
# AUTH_DIR=/data/sessions
# TEMP_DIR=/tmp/untrue
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
# YTDLP_PATH=yt-dlp
# GALLERY_PYTHON=/opt/gallery-dl/bin/python
# LIBREOFFICE_PATH=libreoffice
# TZ=America/Caracas
LOG_LEVEL=info
BAILEYS_LOG_LEVEL=warn
MAX_MEDIA_JOBS=2
MAX_MEDIA_MB=100

# Optional owner-only statistics; PN or LID JID.
BOT_OWNER_JID=

# Optional speech transcription (external service; OCR is local).
ASSEMBLYAI_KEY=

# Optional native sound stickers, disabled by default.
EXPERIMENTAL_SOUND_STICKERS=false

# Optional public Instagram posts provider. No billing required by the bot.
INSTAGRAM_POST_PROVIDER=local
APIDIRECT_API_KEY=

# Optional historical video sticker budget; keep the operator's validated value.
# Default 500 KiB; 1024 restores 1 MiB for the historical candidate only.
# STICKER_LEGACY_MAX_KIB=1024
