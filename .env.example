NODE_ENV=production
# Railway provides PORT and RAILWAY_VOLUME_MOUNT_PATH.
# PORT=3000
# AUTH_DIR=./sessions
# TEMP_DIR=./temp
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
# YTDLP_PATH=yt-dlp
LOG_LEVEL=info
BAILEYS_LOG_LEVEL=warn
MAX_MEDIA_JOBS=2
MAX_MEDIA_MB=100
BOT_OWNER_JID=
COBALT_API_URL=
COBALT_API_KEY=
# Comma-separated additional trusted media hosts (exact domains or subdomains)
COBALT_MEDIA_HOSTS=
EXCHANGERATE_API_KEY=
OCR_SPACE_KEY=
ASSEMBLYAI_KEY=
# Optional private cookie file outside the repo
INSTAGRAM_COOKIES_PATH=

# Optional sound sticker support in private chats and groups; disabled by default
EXPERIMENTAL_SOUND_STICKERS=false

# Optional Instagram Post provider. local uses no API key. For API Direct,
# use a free-only account and do not add billing; local cap is per process.
INSTAGRAM_POST_PROVIDER=local
APIDIRECT_API_KEY=

# Optional historical video sticker budget (native WhatsApp acceptance is not guaranteed).
# Default 500 KiB; set 1024 only to test the pre-modernization 1 MiB budget.
# STICKER_LEGACY_MAX_KIB=1024
